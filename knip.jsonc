{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Vendored agent skills are not part of the app.
  "ignore": [".agents/**"],
  "workspaces": {
    ".": {
      // CodeRabbit loads this file by name.
      "entry": [".coderabbit.config.ts"],
    },
    "packages/infra": {
      // The alchemy CLI loads this file by name.
      "entry": ["alchemy.run.ts"],
    },
    "packages/stripe-emulator": {
      // The emulate CLI loads this file by name.
      "entry": ["emulate.config.ts"],
    },
  },
}
